//Program To Show Concept Array Of Pointers To Object.

#include<iostream.h>
#include<conio.h>
class BCA
{
	public:
		int a;
		void show()
		{
			cout<<"Value Of A : "<<a<<endl<<endl;
		}
};
void main()
{
	clrscr();
	BCA ob,oc;
	BCA *ptr[2]; // Pointer To Object.
	ptr[0] = &ob;
	ptr[1] = &oc;
     //	ptr[2] = &od;
	ptr[0] -> a = 10;
	ptr[0] -> show();
	ptr[1] -> a = 70;
	ptr[1] -> show();
      //	ptr[2] -> a = 100;
       //	ptr[2] -> show();
	getch();
}