// Program To Show Concept Of Operator Overloading Of Binary Operator +.

#include<iostream.h>
#include<conio.h>
class BinaryOp
{
	public:
		int a;
		BinaryOp operator +(BinaryOp ob);
/*		BinaryOp operator +(BinaryOp ob)
		{
			BinaryOp om;
			om.a = a + ob.a;
			return om;
		}
*/
		void show()
		{
			cout<<"Value Of A = "<<a<<endl;
		}
};
BinaryOp BinaryOp :: operator +(BinaryOp ob)
{
	BinaryOp om;
	om.a = a + ob.a;
	return om;
}

void main()
{
	clrscr();
	BinaryOp ob1,ob2,ob3;
	ob1.a = 20;
	ob2.a = 30;
	ob1.show();
	ob2.show();
	ob3 = ob1 + ob2;
	ob3.show();
	getch();
}

/*

NOTE : Statement ob3 = ob1 + ob2 Works As Follows Internally :
	ob3 = ob1.operator(ob2);
	This Is Automatically Or By Default Understood By Compiler.

NOTE 2 : In The Reference Of Binary Operator Overloading, The Statement
	ob3 = ob1.operator(ob2);
	Means, ob1 Is Always Used As Object That Calls The Function Operator
	ob2 Is Always Used As Object Which Is Passed As Argument
	ob3 Is The Catching Argument.
*/