// Show Concept Of Operator Overloading Of binary Operator
#include<iostream.h>
#include<conio.h>
class OpDemoBinary
{
	public:
		int a,b;
		OpDemoBinary operator +(OpDemoBinary ob);
		void show()
		{
			cout<<"value of a:"<<endl;
		}

};
OpDemoBinary OpDemoBinary :: operator + (OpDemoBinary ob)
{
	OpDemoBinary oc;
	oc.a=a+ob.a;

}
void main()
{
	clrscr();
	OpDemoBinary o1,o2,o3;
	o1.a= 10;
	o2.a=20;
	//cout<<"Value Of A = "<<o1.a;
	o3=o1+o2;
	o1.show();
	o2.show();
	o3.show();
       //	++ob;

       //	cout<<"\nValue Of A = "<<ob.a;
	getch();
}
