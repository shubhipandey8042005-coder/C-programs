//program to Show the Concept of Function Overloading.

#include<iostream.h>
#include<conio.h>
void add(int a,int b);
void add(int a,int b,int c);
//void add(int a,int b,float c);
void main()
{
	clrscr();
	add(10,20);
	add(40,50,10);
//	add(10,50,20.40);
	getch();
}
void add(int a,int b)
{
	cout<<"Addition is "<<a+b<<endl;
}
void add(int a,int b,int c)
{
	cout<<"Addition is "<<a+b+c;
}
void add(int a,int b,float c)
{
	cout<<"Addition is "<<a+b+c;
}

