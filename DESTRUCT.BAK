//Program To Show a Concept Of Destructor.
#include<iostream.h>
#include<conio.h>
class BCA
{       public:
	BCA()
	{
		cout<<"constructor";
	}
	~BCA()
	{
		cout<<"Destructor ";
	}
};
void main()
{
	clrscr();
	BCA ob;
	cout<<"\n";
	BCA om;
	cout<<"\n";
	BCA ox;
	cout<<"\n";
	getch();
}