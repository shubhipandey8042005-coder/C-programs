// Program To Show Concept Of Local Class.

#include<iostream.h>
#include<conio.h>
void show();
void main()
{
	clrscr();
	show();
	getch();
}
void show()
{
	class LocalClass
	{
		int a;
		public:
			void display(int x)
			{
				a = x;
				cout<<"Value Of A Using Local Class = "<<a;
			}
	};
	LocalClass ob;
	ob.display(50);
}