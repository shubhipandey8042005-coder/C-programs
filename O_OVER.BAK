// Program To Show Concept Of Operator Overloading Of Unary Operator ++.

#include<iostream.h>
#include<conio.h>
class Op_Over
{
	public:
		int a;
		void operator ++()
		{
		       a++;
		}
};
void main()
{
	clrscr();
	Op_Over ob;
	ob.a= 20;
	cout<<"Value Of A = "<<ob.a;
	++ob;
	cout<<"\nValue Of A = "<<ob.a;
	getch();
}
