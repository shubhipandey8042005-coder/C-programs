// Program To Show A Concept Of Constructor In Drived Class.
#include<iostream.h>
#include<conio.h>
class A
{
	public:
	A()
	{
		cout<<"Welcome in class A"<<endl;
	}
};
class B: public A
{
       public:
       B()
	{
		cout<<"Welcome in class B"<<endl;
	}
};
class C :public B
{
	public:
	C()
	{
		cout<<"Welcome in class C"<<endl;
	}
};
